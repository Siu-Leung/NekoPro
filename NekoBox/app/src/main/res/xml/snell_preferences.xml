<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_social_emoji_symbols"
        app:key="name"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory app:title="@string/proxy_cat">
        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="serverAddress"
            app:title="@string/server_address"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_maps_directions_boat"
            app:key="serverPort"
            app:title="@string/server_port"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_settings_password"
            app:key="psk"
            app:title="@string/password" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="4"
            app:entries="@array/snell_version_entries"
            app:entryValues="@array/snell_version_entries"
            app:icon="@drawable/ic_baseline_layers_24"
            app:key="version"
            app:title="Snell Version"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="default"
            app:entries="@array/snell_mode_entries"
            app:entryValues="@array/snell_mode_entries"
            app:icon="@drawable/ic_baseline_stream_24"
            app:key="mode"
            app:title="Snell v6 Mode"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Obfuscation">
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="none"
            app:entries="@array/snell_obfs_entries"
            app:entryValues="@array/snell_obfs_entries"
            app:icon="@drawable/ic_baseline_layers_24"
            app:key="obfsMode"
            app:title="Obfs Mode"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="obfsHost"
            app:title="Obfs Host"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>
