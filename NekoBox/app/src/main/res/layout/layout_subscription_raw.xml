<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surge_canvas"
    android:orientation="vertical">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/raw_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?selectedColorPrimary" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/surge_surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/raw_format_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_protocol_badge"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="8dp"
                    android:paddingTop="2.5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2.5dp"
                    android:textColor="@color/surge_text_primary"
                    android:textSize="11sp"
                    tools:text="Clash YAML" />

                <TextView
                    android:id="@+id/raw_meta_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/surge_text_secondary"
                    android:textSize="11.5sp"
                    tools:text="48.2 KB · 980 lines" />

                <TextView
                    android:id="@+id/raw_dns_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_protocol_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textSize="11sp"
                    tools:text="DNS Ready (2)" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_detect_dns"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:text="@string/raw_sub_extract_dns"
                    android:textAllCaps="false"
                    android:textColor="@color/surge_text_primary"
                    android:textSize="11.5sp"
                    app:backgroundTint="@color/card_action_bg"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_action_dns"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="13.5dp"
                    app:iconTint="?attr/primaryOrTextPrimary"
                    app:strokeColor="@color/card_action_stroke"
                    app:strokeWidth="1dp" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_refetch"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:text="@string/raw_sub_refetch"
                    android:textAllCaps="false"
                    android:textColor="@color/surge_text_primary"
                    android:textSize="11.5sp"
                    app:backgroundTint="@color/card_action_bg"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_baseline_refresh_24"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="13.5dp"
                    app:iconTint="?attr/primaryOrTextPrimary"
                    app:strokeColor="@color/card_action_stroke"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/raw_notice_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/surge_amber"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/surge_surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.blacksquircle.ui.editorkit.widget.TextProcessor
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:completionThreshold="2"
                android:importantForAutofill="no"
                android:scrollbars="none"
                android:textColor="@color/surge_text_primary" />

            <com.blacksquircle.ui.editorkit.widget.TextScroller
                android:id="@+id/scroller"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                app:thumbTint="?colorPrimary" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surge_divider" />

    <LinearLayout
        android:id="@+id/keyboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surge_surface_subtle"
        android:elevation="2dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/action_tab"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/raw_sub_key_tab"
            android:padding="9dp"
            android:src="@drawable/baseline_keyboard_tab_24"
            app:tint="@color/surge_text_primary" />

        <moe.matsuri.nb4a.ui.ExtendedKeyboard
            android:id="@+id/extended_keyboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/surge_surface_subtle"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="6"
            tools:listitem="@layout/item_keyboard_key" />

        <ImageView
            android:id="@+id/action_undo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/raw_sub_key_undo"
            android:padding="9dp"
            android:src="@drawable/baseline_undo_24"
            app:tint="@color/surge_text_primary" />

        <ImageView
            android:id="@+id/action_redo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/raw_sub_key_redo"
            android:padding="9dp"
            android:src="@drawable/baseline_redo_24"
            app:tint="@color/surge_text_primary" />

    </LinearLayout>

</LinearLayout>
