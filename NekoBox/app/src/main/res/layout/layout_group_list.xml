<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surge_canvas"
    android:orientation="vertical"
    tools:context=".ui.ConfigurationFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Collapsible Surge inline search bar toggled from More -> Search Nodes -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/surge_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surge_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/action_search_nodes"
                app:srcCompat="@drawable/ic_baseline_search_24"
                app:tint="@color/surge_text_secondary" />

            <EditText
                android:id="@+id/surge_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_nodes_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/surge_text_primary"
                android:textColorHint="@color/surge_text_secondary"
                android:textSize="13.5sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/surge_search_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@android:string/cancel"
                android:focusable="true"
                android:padding="7dp"
                app:srcCompat="@drawable/ic_navigation_close"
                app:tint="@color/surge_text_secondary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/group_tab"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surge_surface"
        android:elevation="0dp"
        android:visibility="gone"
        app:tabIndicator="@drawable/bg_surge_tab_indicator"
        app:tabIndicatorColor="?tabIndicatorColor"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="2.5dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="14dp"
        app:tabPaddingStart="14dp"
        app:tabRippleColor="?tabRippleColor"
        app:tabSelectedTextColor="?tabSelectedTextColor"
        app:tabTextAppearance="@style/TextAppearance.NekoPro.SurgeTab"
        app:tabTextColor="?tabTextColor"
        app:tabUnboundedRipple="false" />

    <View
        android:id="@+id/group_tab_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surge_divider"
        android:visibility="gone" />

    <!-- Surge-inspired compact telemetry & quick route-mode control bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/surge_status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/surge_surface"
        app:cardCornerRadius="13dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="10dp"
            android:paddingBottom="9dp">

            <View
                android:id="@+id/surge_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_surge_status_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/surge_active_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/surge_status_idle_hint"
                    android:textColor="@color/surge_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/surge_active_ip_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:lineSpacingExtra="1.5dp"
                    android:maxLines="2"
                    android:textColor="@color/surge_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="入口 203.0.113.8 · 🇨🇳 CN · AS4134\n出口 104.28.14.92 · 🇭🇰 HK · AS13335"
                    tools:visibility="visible" />

            </LinearLayout>

            <TextView
                android:id="@+id/surge_route_mode_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_surge_mode_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minHeight="28dp"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:singleLine="true"
                android:text="@string/route_mode_rule"
                android:textColor="@color/surge_text_primary"
                android:textSize="11.5sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/group_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>