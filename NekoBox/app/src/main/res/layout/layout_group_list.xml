<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surge_canvas"
    android:orientation="vertical"
    tools:context=".ui.MainActivity">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/group_tab"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/surge_surface"
        android:clipToPadding="false"
        android:elevation="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:tabBackground="@drawable/bg_surge_tab_item"
        app:tabGravity="start"
        app:tabIndicator="@drawable/bg_surge_tab_indicator"
        app:tabIndicatorColor="?tabIndicatorColor"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMinWidth="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="14dp"
        app:tabPaddingStart="14dp"
        app:tabRippleColor="?tabRippleColor"
        app:tabSelectedTextColor="?tabSelectedTextColor"
        app:tabTextAppearance="@style/TextAppearance.NekoPro.SurgeTab"
        app:tabTextColor="?tabTextColor"
        app:tabUnboundedRipple="false" />

    <View
        android:id="@+id/group_tab_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surge_divider" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/surge_status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/surge_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:id="@+id/surge_status_beacon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_surge_status_beacon">

                <View
                    android:id="@+id/surge_status_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_surge_status_dot" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/surge_active_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/surge_status_idle_hint"
                    android:textColor="@color/surge_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/surge_status_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/surge_status_idle_sub"
                    android:textColor="@color/surge_text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/surge_route_mode_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surge_mode_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="11dp"
                android:paddingTop="5.5dp"
                android:paddingEnd="11dp"
                android:paddingBottom="5.5dp"
                android:text="@string/route_mode_rule"
                android:textColor="@color/surge_text_primary"
                android:textSize="11.5sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/group_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
