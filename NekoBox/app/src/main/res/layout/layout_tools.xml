<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surge_canvas"
    android:orientation="vertical"
    tools:context=".ui.ToolsFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tools_tab"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/surge_surface"
        android:elevation="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:tabBackground="@drawable/bg_surge_tab_item"
        app:tabIndicator="@drawable/bg_surge_tab_indicator"
        app:tabIndicatorColor="?tabIndicatorColor"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabPaddingStart="16dp"
        app:tabPaddingEnd="16dp"
        app:tabRippleColor="?tabRippleColor"
        app:tabSelectedTextColor="?tabSelectedTextColor"
        app:tabTextAppearance="@style/TextAppearance.NekoPro.SurgeTab"
        app:tabTextColor="?tabTextColor"
        app:tabUnboundedRipple="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surge_divider" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tools_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>